#!/bin/bash

set -euo pipefail

install_location="${2:-/Library/Input Methods}"
old_app="/Library/Input Methods/Squirrel.app"
current_app="${install_location%/}/LingoSphere.app"
console_user="$(/usr/bin/stat -f%Su /dev/console)"
timestamp="$(/bin/date +%Y%m%d-%H%M%S)"
support_root="/Library/Application Support/LingoSphere"
backup_root="${support_root}/backups/${timestamp}"
pending_backup_file="${support_root}/pending-backup.txt"
script_dir="$(cd "$(dirname "$0")" && pwd)"
migrator="${LINGOSPHERE_INPUT_SOURCE_MIGRATOR:-${script_dir}/input-source-migrator}"
backed_up_any=0

run_for_console_user() {
    if [[ -n "${console_user}" && "${console_user}" != "root" && "${console_user}" != "loginwindow" ]]; then
        /usr/bin/sudo -u "${console_user}" "$@"
    else
        "$@"
    fi
}

disable_family() {
    local app_path="$1"
    shift
    [[ -d "${app_path}" && -x "${migrator}" ]] || return 0
    run_for_console_user "${migrator}" register "${app_path}" || true
    run_for_console_user "${migrator}" disable "$@" || true
}

backup_current_app() {
    [[ -d "${current_app}" ]] || return 0
    /bin/mkdir -p "${backup_root}"
    /usr/bin/ditto "${current_app}" "${backup_root}/LingoSphere.app"
    backed_up_any=1
}

restore_legacy_copy_for_cleanup_if_needed() {
    [[ ! -d "${old_app}" ]] || return 1
    local latest_backup=""
    if [[ -f "${support_root}/latest-backup.txt" ]]; then
        latest_backup="$(/bin/cat "${support_root}/latest-backup.txt")"
    fi
    case "${latest_backup}" in
        "${support_root}"/backups/*)
            ;;
        *)
            latest_backup=""
            ;;
    esac
    [[ -n "${latest_backup}" && -d "${latest_backup}/Squirrel.app" ]] || return 1
    /usr/bin/ditto "${latest_backup}/Squirrel.app" "${old_app}"
    return 0
}

# Keep an already healthy LingoSphere registration enabled across upgrades.
# Disabling and re-enabling the same bundle would make macOS ask for input-
# method consent again on every update. A half-enabled v1.2.0.1005 install is
# repaired after replacement by enabling its parent source first.

legacy_was_restored=0
if restore_legacy_copy_for_cleanup_if_needed; then
    legacy_was_restored=1
fi
disable_family \
    "${old_app}" \
    "im.rime.inputmethod.Squirrel.Hans" \
    "im.rime.inputmethod.Squirrel.Hant" \
    "im.rime.inputmethod.Squirrel"

/usr/bin/killall LingoSphere >/dev/null 2>&1 || true
/usr/bin/killall Squirrel >/dev/null 2>&1 || true

# Keep a recoverable copy of the previous branded build. PackageKit performs
# the actual replacement, so a failed installation still leaves it in place.
backup_current_app

# A copy restored solely to clean the v1.2.0.1005 legacy registration is moved
# back out immediately. A genuinely installed Squirrel.app remains until the
# postinstall phase, so it also survives if PackageKit aborts before success.
if [[ "${legacy_was_restored}" == "1" && -d "${old_app}" ]]; then
    /bin/mkdir -p "${backup_root}"
    /bin/mv "${old_app}" "${backup_root}/Squirrel-cleanup-copy.app"
    backed_up_any=1
fi

/bin/mkdir -p "${support_root}"
/usr/bin/printf '%s\n' "${backup_root}" > "${pending_backup_file}"
if [[ "${backed_up_any}" == "1" ]]; then
    /usr/bin/printf '%s\n' "${backup_root}" > "${support_root}/latest-backup.txt"
fi

exit 0
